# Organizers' dataset API. Put the full GET link from the student guide here,
# with {group_id} in place of the group value, e.g. ...&group_id={group_id}
CQA_DATASET_URL=

# LLM provider: "anthropic" (real evaluation) or "heuristic" (offline keyword fallback, demo/dev only)
CQA_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CQA_MODEL=claude-opus-5-5
# low | medium | high  (higher = more accurate, slower, more expensive)
CQA_EFFORT=medium
# parallel evaluations in batch mode
CQA_CONCURRENCY=6
