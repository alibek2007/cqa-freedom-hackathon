# Organizers' dataset API. Put the full GET link from the student guide here,
# with {group_id} in place of the group value, e.g. ...&group_id={group_id}
CQA_DATASET_URL=

# team_name written into results/*/results.json
CQA_TEAM_NAME=

# Which model evaluates the dialogs:
#   gemini    - Google Gemini API free tier (key: https://aistudio.google.com/apikey)
#   anthropic - Claude (paid, key: https://platform.claude.com)
#   openai    - any OpenAI-compatible API (Groq, OpenRouter, local Ollama): set CQA_BASE_URL + CQA_API_KEY
#   heuristic - offline keyword rules, UI development only
CQA_PROVIDER=gemini

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# for provider=openai, e.g. http://localhost:11434/v1 (Ollama) or https://api.groq.com/openai/v1
CQA_BASE_URL=
CQA_API_KEY=

# empty = provider default (gemini-3.8-flash / claude-opus-5-5)
CQA_MODEL=
# reasoning effort: low | medium | high
CQA_EFFORT=low
# parallel evaluations in batch mode (empty = 2 for gemini, 6 otherwise)
CQA_CONCURRENCY=
# USD per 1M tokens, only needed to override built-in prices (free tier = 0)
CQA_PRICE_IN=
CQA_PRICE_OUT=
